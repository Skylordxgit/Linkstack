NODE_ENV=development
PORT=4000

# --- Database (Supabase Postgres) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# DATABASE_URL: the pooled "Transaction" connection string (port 6543,
#   ?pgbouncer=true) — used at runtime, required for serverless functions
#   which open many short-lived connections.
# DIRECT_URL: the direct connection string (port 5432) — used only for
#   `prisma migrate deploy`/`dev`, which the transaction pooler can't run.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (media uploads) ---
# Same project as above. Settings -> API for the URL; Settings -> API ->
# service_role key for SUPABASE_SERVICE_ROLE_KEY (server-only — never expose
# this to the frontend/browser). Create a public bucket named "media" (or
# change SUPABASE_STORAGE_BUCKET to match) in Storage before uploading.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=media

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=linkapp_session

# Single admin account (used by prisma seed script)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_this_password

# URLs
FRONTEND_URL=https://your-site.netlify.app
APP_URL=https://your-site.netlify.app

# Uploads
MAX_UPLOAD_SIZE=10485760

# Analytics
ANALYTICS_RETENTION_DAYS=365
