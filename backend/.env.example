NODE_ENV=development
PORT=4000

# Database (MySQL — e.g. a Hostinger-provisioned database).
# hPanel -> Databases -> MySQL Databases gives you the DB name and DB user
# (usually prefixed with your account id, e.g. u123456789_linkapp /
# u123456789_linkuser) and lets you set the DB password. If your Node app
# runs on the same VPS as the database, use "localhost"; if it's remote,
# use the host hPanel shows and enable "Remote MySQL" for your VPS's IP.
DATABASE_URL="mysql://u123456789_linkuser:CHANGE_ME_DB_PASSWORD@localhost:3306/u123456789_linkapp"

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=linkapp_session

# Single admin account (used by prisma seed script)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_this_password

# URLs
FRONTEND_URL=https://domain.com
APP_URL=https://domain.com

# Uploads
UPLOAD_PATH=uploads
MAX_UPLOAD_SIZE=10485760

# Analytics
ANALYTICS_RETENTION_DAYS=365
