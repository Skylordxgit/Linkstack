# Public API base URL used by the browser.
# Leave as /api to go through the built-in dev proxy (see next.config.js) or
# an Nginx location block in production. Set to an absolute URL only if the
# API is served from a different origin than the frontend.
NEXT_PUBLIC_API_URL=/api

# Server-side (SSR) requests talk to the backend directly, bypassing Nginx.
# Defaults to http://localhost:4000/api if unset.
INTERNAL_API_URL=http://localhost:4000/api

# Used by next.config.js dev rewrites (/api/* -> BACKEND_ORIGIN/api/*)
BACKEND_ORIGIN=http://localhost:4000

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match COOKIE_NAME in backend/.env (used by middleware.ts to detect a session cookie)
COOKIE_NAME=linkapp_session
