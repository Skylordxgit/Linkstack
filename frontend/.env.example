# Public API base URL used by the browser.
# Leave as /api — on Netlify, netlify.toml redirects /api/* to the backend
# Function; in local dev, next.config.js proxies it to BACKEND_ORIGIN. Only
# set this to an absolute URL if the API is served from a different origin.
NEXT_PUBLIC_API_URL=/api

# Server-side (SSR) requests. Leave unset — it's auto-derived (Netlify's own
# `URL` env var in production, http://localhost:4000/api in local dev). Only
# set this to override that default.
# INTERNAL_API_URL=

# Used only by next.config.js's local-dev rewrite proxy (never reached in
# production — Netlify's own redirect, or Nginx on a self-hosted VPS, takes
# over before requests would reach this).
BACKEND_ORIGIN=http://localhost:4000

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must match COOKIE_NAME in backend/.env (used by middleware.ts to detect a session cookie)
COOKIE_NAME=linkapp_session
